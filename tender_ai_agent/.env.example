APP_ENV=development
LOG_LEVEL=INFO
DRY_RUN=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CONTENT_QUALITY_VALIDATION_ENABLED=true
AI_VALIDATION_ENABLED=true
AI_VALIDATION_THRESHOLD=0.6
AI_VALIDATION_DELAY_SECONDS=0

# Asignacion de unidad de negocio (etapa negocio_assignment, entre dedup y db_mapping).
NEGOCIO_ASSIGNMENT_ENABLED=true
# Tabla de SIDOC desde donde se resuelve el negocio_id por nombre.
NEGOCIO_TABLE_NAME=negocio
# Score minimo (0-1) para que las reglas decidan sin consultar a Gemini.
NEGOCIO_RULES_STRONG_THRESHOLD=0.45
# Margen minimo sobre el segundo negocio; si no se cumple, desempata la prioridad del catalogo.
NEGOCIO_RULES_MARGIN=0.12
# Pausa en segundos entre llamadas a Gemini de esta etapa (0 para API paga).
NEGOCIO_ASSIGNMENT_DELAY_SECONDS=0

DATABASE_URL=
DB_TABLE_NAME=licitacion

DEFAULT_DB_ESTADO=Sin Analizar
DEFAULT_DB_SELECCION=Seleccionada por Agente IA
# Solo fallback: se usa si la etapa negocio_assignment no pudo asignar ningun negocio.
DEFAULT_NEGOCIO_ID=
DEFAULT_COLABORADOR_ID=
DEFAULT_RESPONSABLE_ID=
DEFAULT_FILIAL_ID=
DEFAULT_FILTRO_GEMINI=No analizada
DEFAULT_COMENTARIOS_PERSONALES=
DEFAULT_ESTADO_SEGUIMIENTO=Pendiente
DEFAULT_SITUACION=Abierto
DEFAULT_CONTROLCOMERCIAL=false
DEFAULT_COMENTARIO_PREFIX=Cargado automaticamente por tender_ai_agent

DEFAULT_PROVIDERS=openai,perplexity
DEFAULT_REGIONS=all
OUTPUT_DIR=outputs
LOG_DIR=logs
REQUEST_TIMEOUT_SECONDS=60
MAX_RESULTS_PER_SOURCE=20
