APP_ENV=development
LOG_LEVEL=INFO
DRY_RUN=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
# agent (por defecto) usa la Agent API de Perplexity con el esfuerzo indicado; sonar vuelve al endpoint viejo.
PERPLEXITY_DISCOVERY_API=agent
PERPLEXITY_AGENT_EFFORT=low

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Juez IA (calidad de contenido + validacion de negocio): anthropic o gemini.
# Si AI_JUDGE_PROVIDER=anthropic y falta ANTHROPIC_API_KEY, se usa Gemini como respaldo.
AI_JUDGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento del juez: low, medium, high.
ANTHROPIC_EFFORT=low
# Segunda lectura: si Perplexity devuelve vacio pero trajo resultados web, Claude los lee y extrae convocatorias.
SECOND_READER_ENABLED=true
SECOND_READER_MODEL=claude-sonnet-5-5
CONTENT_QUALITY_VALIDATION_ENABLED=true
AI_VALIDATION_ENABLED=true
AI_VALIDATION_THRESHOLD=0.6
AI_VALIDATION_DELAY_SECONDS=0

# Asignacion de unidad de negocio (etapa negocio_assignment, entre dedup y db_mapping).
NEGOCIO_ASSIGNMENT_ENABLED=true
# Conectores a APIs de portales (config/connectors.yaml). false los apaga a todos.
CONNECTORS_ENABLED=true
# Tabla de SIDOC desde donde se resuelve el negocio_id por nombre.
NEGOCIO_TABLE_NAME=negocio
# Juez 3: modelo de Claude que asigna el negocio (usa ANTHROPIC_API_KEY).
NEGOCIO_JUDGE_MODEL=claude-opus-5-5
# Respaldo por palabras clave (solo si Claude no responde): score minimo y margen.
NEGOCIO_RULES_STRONG_THRESHOLD=0.45
NEGOCIO_RULES_MARGIN=0.12
# Pausa en segundos entre llamadas al Juez 3 (0 para API paga).
NEGOCIO_ASSIGNMENT_DELAY_SECONDS=0

DATABASE_URL=
DB_TABLE_NAME=licitacion

DEFAULT_DB_ESTADO=Sin Analizar
DEFAULT_DB_SELECCION=Seleccionada por Agente IA
# Solo fallback: se usa si la etapa negocio_assignment no pudo asignar ningun negocio.
DEFAULT_NEGOCIO_ID=
DEFAULT_COLABORADOR_ID=
DEFAULT_RESPONSABLE_ID=
DEFAULT_FILIAL_ID=
DEFAULT_FILTRO_GEMINI=No analizada
DEFAULT_COMENTARIOS_PERSONALES=
DEFAULT_ESTADO_SEGUIMIENTO=Pendiente
DEFAULT_SITUACION=Abierto
DEFAULT_CONTROLCOMERCIAL=false

DEFAULT_PROVIDERS=openai,perplexity
DEFAULT_REGIONS=all
OUTPUT_DIR=outputs
LOG_DIR=logs
REQUEST_TIMEOUT_SECONDS=60
MAX_RESULTS_PER_SOURCE=20
# Dias de margen antes de descartar una oportunidad por deadline vencido (zona horaria, formato de fecha).
DEADLINE_GRACE_DAYS=1
# Idiomas que pasan la elegibilidad (ISO 639-1). Lo demas se descarta como language_not_allowed.
ALLOWED_LANGUAGES=es,en,pt,fr
